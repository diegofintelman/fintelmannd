# Envio do formulário de diagnóstico por e-mail.
#
# Sem estas variáveis o site funciona normalmente: o formulário continua
# abrindo o WhatsApp com as respostas estruturadas. O e-mail é um segundo
# canal, não o principal. Ver app/api/diagnostico/route.ts.
#
# Nunca comitar valores reais. Configure no painel da hospedagem, na seção
# de variáveis de ambiente.

# Chave da API do Resend (resend.com), com o domínio verificado.
RESEND_API_KEY=

# Opcionais. Sem eles, o destino é o e-mail em lib/site.ts.
DIAGNOSTICO_PARA=
DIAGNOSTICO_DE=
