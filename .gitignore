# Dependências
node_modules
.pnp
.pnp.js

# Build do Next.js
# Sem estas linhas o build inteiro (milhares de arquivos) entra no commit.
# O .gitignore anterior era do projeto Vite e só cobria `dist`.
.next/
out/
build/
dist
dist-ssr

# Cache de ferramentas
*.tsbuildinfo
next-env.d.ts

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Variáveis de ambiente — NUNCA commitar valores reais.
# `.env.example` é versionado de propósito: só tem as chaves, sem valor.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Arquivos locais de editor e sistema
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# Configuração local de preview desta máquina
.claude/launch.json
