{
  // Hospedagem na Cloudflare Workers (Static Assets) — substitui a Vercel.
  // Build: `npm run build` gera ./dist; deploy: `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fintelmannd",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-03",
  // Domínios personalizados deste Worker (a lista substitui a do painel a cada deploy).
  // portifolio.* foi incorporado à rota /trafego: o Worker redireciona (301).
  "routes": [
    { "pattern": "fintelmannd.com.br", "custom_domain": true },
    { "pattern": "www.fintelmannd.com.br", "custom_domain": true },
    { "pattern": "portifolio.fintelmannd.com.br", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // O Worker roda antes das páginas (negociação de Markdown e /.well-known),
    // mas arquivos estáticos pesados são servidos direto, sem consumir requisições.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/previews/*",
      "!/favicon.png",
      "!/og-image.jpg",
      "!/placeholder.svg",
      "!/llms.txt",
      "!/llms-full.txt",
      "!/robots.txt",
      "!/sitemap.xml"
    ]
  },
  "observability": { "enabled": true }
}
